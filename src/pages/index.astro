---
import Layout from "../layouts/Layout.astro";
import Particles from "../components/Particles.astro";

const links = [
  { href: "/work", label: "my work" },
  { href: "/blog", label: "blog" },
  { href: "https://github.com/thomasdoesstuff", label: "github", external: true },
];
---

<Layout bare>
  <Particles />

  <main class="flex min-h-dvh flex-col items-center justify-center px-6">
    <h1
      class="fade-in text-center text-7xl tracking-tight text-balance text-fg [text-shadow:0_0_40px_rgb(92_225_255/0.25)]"
    >
      thomas is not a web dev
    </h1>

    <nav
      aria-label="Primary"
      class="fade-in mt-12 flex flex-col items-center gap-4 text-xl text-dim [animation-delay:1.2s]"
    >
      {
        links.map((link) => (
          <a
            href={link.href}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
            class="decoration-signal-cyan decoration-2 underline-offset-8 transition-colors outline-offset-4 hover:text-fg hover:underline focus-visible:text-fg focus-visible:outline-2 focus-visible:outline-signal-cyan"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </main>
</Layout>
