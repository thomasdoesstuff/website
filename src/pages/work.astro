---
import Layout from "../layouts/Layout.astro";
import Particles from "../components/Particles.astro";
---

<Layout>
  <Particles />

  <main class="flex min-h-dvh flex-col items-center justify-center px-6">
    <h1
      class="fade-in tracking-tight text-balance text-fg [text-shadow:0_0_40px_rgb(92_225_255/0.25)]"
    >
    Welcome to my work page. <br />
    Unfortunately, I deal with too much proprietary and export controlled information to actually show you what I do. <br />
    But that's ok. I can still show you code snippets of many of my favorite systems I've built.
    </h1>
  </main>
</Layout>
