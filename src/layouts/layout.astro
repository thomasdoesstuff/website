---
import "../styles/global.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Thomas | Software Engineer",
  description = "Portfolio of Thomas, a software engineer building reliable systems.",
} = Astro.props;

const path = Astro.url.pathname;
const links = [
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070b16" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-ink font-sans text-fg antialiased">
    <header class="flex max-w-3xl items-center justify-between px-6 py-6">
      <a
        href="/"
        class="font-semibold tracking-tight outline-offset-4 focus-visible:outline-2 focus-visible:outline-signal-cyan"
      >
        Thomas
      </a>
      <nav class="flex gap-6 text-sm">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={path.startsWith(link.href) ? "page" : undefined}
              class:list={[
                "underline-offset-8 transition-colors outline-offset-4 focus-visible:outline-2 focus-visible:outline-signal-cyan",
                path.startsWith(link.href)
                  ? "text-fg underline decoration-signal-cyan decoration-2"
                  : "text-dim hover:text-fg",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="max-w-3xl px-6 py-10 text-sm text-dim">
      &copy; {new Date().getFullYear()} Thomas
    </footer>
  </body>
</html>
